# ─── Clerk (Auth) ───────────────────────────────────────────────────────────
# Dev keys:   pk_test_... / sk_test_...
# Prod keys:  pk_live_... / sk_live_...   (from dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk redirects after sign-in / sign-up (Clerk v5 names)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── Database (Supabase PostgreSQL) ─────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── AI ─────────────────────────────────────────────────────────────────────
# Google AI Studio → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ─── App URL ─────────────────────────────────────────────────────────────────
# Dev:  http://localhost:3000
# Prod: https://your-domain.com  (used in billing redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── PayMongo (PHP payments — GCash, Maya, cards) ────────────────────────────
# Test keys: pk_test_... / sk_test_...  (dashboard.paymongo.com → Developers → API Keys)
# Live keys: pk_live_... / sk_live_...
PAYMONGO_SECRET_KEY=sk_test_...

# PayMongo Webhook → Dashboard → Developers → Webhooks
# Event: checkout_session.payment.paid
# URL:   https://your-domain.com/api/webhooks/paymongo
PAYMONGO_WEBHOOK_SECRET=whsk_...

# ─── Stripe (USD card payments) ──────────────────────────────────────────────
# Test keys: sk_test_...  (dashboard.stripe.com → Developers → API Keys)
# Live keys: sk_live_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe CLI (dev): stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Stripe Dashboard (prod): Developers → Webhooks → Add endpoint
# Events: checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Clerk Webhook Secret ────────────────────────────────────────────────────
# Clerk Dashboard → Webhooks → choose endpoint → Signing Secret
# Subscribed events: user.created, user.deleted
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Inngest (background jobs — webhook retry queue) ─────────────────────────
# Dev:  no keys needed — run `npx inngest-cli@latest dev` alongside `npm run dev`
# Prod: inngest.com → Your App → Signing Key + Event Key
INNGEST_SIGNING_KEY=signkey-prod-...
INNGEST_EVENT_KEY=...
